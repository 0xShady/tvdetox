# Copy to tv.env (ignored by git) and edit.

# Your TV's IP address and adb port. Find the IP in Settings > Network.
TV=192.168.1.50:5555

# Lists in debloat/lists/ to disable, separated by spaces.
DEBLOAT_LISTS="google-tv"

# 0 turns animations off, 0.5 makes them twice as fast, 1.0 is the default.
ANIMATION_SCALE=0.5

# Screensaver that restore.sh and screensaver/uninstall.sh put back.
STOCK_SCREENSAVER=com.google.android.apps.tv.dreamx/.service.Backdrop

# Apps shown first on the home screen, in order, separated by spaces. Rebuild the launcher after changing it.
FAVORITES="com.google.android.youtube.tv com.netflix.ninja com.google.android.youtube.tvmusic"

# Home screen wallpaper, and the image the screensaver shows when its photo folder is empty.
# Paths to a JPEG or PNG, relative to this folder. Rebuild the app after changing one.
WALLPAPER=assets/wallpaper.jpg
SCREENSAVER_WALLPAPER=assets/screensaver.jpg

# Weather and sunrise/sunset on the home screen and screensaver, from Open-Meteo (free, no key).
# Leave empty to turn it off. Find your coordinates on https://open-meteo.com or any map.
LATITUDE=
LONGITUDE=
TEMP_UNIT=celsius
